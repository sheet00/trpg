/**
 * Cloudflare Workers (Assets) 用 Wrangler 設定
 */
{
  "$schema": "src/node_modules/wrangler/config-schema.json",
  "name": "trpg",
  "main": "./worker/public.ts",
  "compatibility_date": "2024-09-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./src/dist",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "AI_PROXY",
      "service": "trpg-worker"
    }
  ],
  "observability": {
    "enabled": true
  }
}
